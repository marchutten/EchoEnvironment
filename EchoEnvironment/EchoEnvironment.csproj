<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Phase 3: the System.IO.Ports PackageReference was REMOVED from this project. The App no longer
      talks to SerialPort at all - it consumes ISensorStream. The package still reaches the App
      transitively through EchoEnvironment.Hardware, which is now the only project besides Hardware
      allowed to name a serial type.
    -->
    <ProjectReference Include="..\EchoEnvironment.Core\EchoEnvironment.Core.csproj" />
    <ProjectReference Include="..\EchoEnvironment.Hardware\EchoEnvironment.Hardware.csproj" />
    <!--
      Phase 5: the App no longer builds any geometry itself. MeshFactory, ScenePrimitives and
      WpfMath moved to EchoEnvironment.Rendering, so the App now depends on Rendering and reaches
      Core through it. The App keeps its own direct Core reference because MainWindow still names
      SensorFrame, OrientationFilter and ColorScale directly - removing that edge is Phase 6b's job,
      not a side effect of this move.
    -->
    <ProjectReference Include="..\EchoEnvironment.Rendering\EchoEnvironment.Rendering.csproj" />
  </ItemGroup>

</Project>
