<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Phase 1 seam: lets EchoEnvironment.Tests reach the internal domain classes
      (SensorFrameParser, OrientationFilter) while they still live in this assembly.
      Phase 2 moves them into EchoEnvironment.Core, where they become public; this
      item can then be deleted.
    -->
    <InternalsVisibleTo Include="EchoEnvironment.Tests" />
  </ItemGroup>

</Project>
