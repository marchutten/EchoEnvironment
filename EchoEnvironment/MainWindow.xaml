<Window x:Class="EchoEnvironment.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EchoEnvironment" Height="650" Width="900">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6">
            <TextBlock Text="Port:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="PortComboBox" Width="90" IsEditable="True"/>
            <Button Content="Refresh" Margin="4,0" Padding="8,0" Click="Refresh_Click"/>
            <TextBlock Text="Baud:" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <TextBox x:Name="BaudTextBox" Text="115200" Width="70" VerticalContentAlignment="Center"/>
            <Button x:Name="ConnectButton" Content="Connect" Margin="8,0" Padding="12,0" Click="Connect_Click"/>
            <CheckBox x:Name="ShowGridCheckBox" Content="Show grid" VerticalAlignment="Center" Margin="0,0,8,0" Click="ShowGrid_Click"/>
            <CheckBox x:Name="KeepMapCheckBox" Content="Keep map" VerticalAlignment="Center" Margin="0,0,8,0" Click="KeepMap_Click"/>
            <!-- Phase 4: frame rate is a declared UI setting, not a side effect of the baud rate.
                 Items are populated in code so the choices and the interval share one source. -->
            <TextBlock Text="Render:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="RenderRateComboBox" Width="60" VerticalAlignment="Center" SelectionChanged="RenderRate_SelectionChanged"/>
            <TextBlock Text="Hz" VerticalAlignment="Center" Margin="4,0,0,0"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="8,0"/>
        </StackPanel>
        <Border DockPanel.Dock="Right" Width="280" Background="#FF181818" Padding="8"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Zone distances (mm)" Foreground="White" Margin="0,0,0,6"/><TextBlock x:Name="OrientationText" DockPanel.Dock="Bottom" Foreground="White" FontFamily="Consolas" Margin="0,10,0,0" Text="Orientation: no IMU data"/><UniformGrid x:Name="HeatGrid" DockPanel.Dock="Top" Height="264" Width="264" VerticalAlignment="Top"/><Border Background="#FF101820" Margin="0,8,0,0"><Viewport3D x:Name="BoardViewport" ClipToBounds="True"><Viewport3D.Camera><PerspectiveCamera Position="0.9,0.7,1.3" LookDirection="-0.9,-0.7,-1.3" UpDirection="0,1,0" FieldOfView="45"/></Viewport3D.Camera><ModelVisual3D><ModelVisual3D.Content><Model3DGroup><AmbientLight Color="#FF707070"/><DirectionalLight Color="White" Direction="-1,-1,-1"/></Model3DGroup></ModelVisual3D.Content></ModelVisual3D><ModelVisual3D x:Name="BoardVisual"/></Viewport3D></Border></DockPanel></Border>
        <Border x:Name="ViewBorder" Background="#FF101820" MouseLeftButtonDown="View_MouseDown" MouseLeftButtonUp="View_MouseUp" MouseMove="View_MouseMove" MouseWheel="View_MouseWheel"><Viewport3D x:Name="Viewport" ClipToBounds="True">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="Camera" NearPlaneDistance="0.01" Position="2,1.5,4" LookDirection="-2,-1.5,-4" UpDirection="0,1,0" FieldOfView="50"/>
            </Viewport3D.Camera>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight Color="#FF707070"/>
                        <DirectionalLight Color="White" Direction="-1,-1,-1"/>
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
            <ModelVisual3D x:Name="SensorVisual"/>
        </Viewport3D></Border>
    </DockPanel>
</Window>
