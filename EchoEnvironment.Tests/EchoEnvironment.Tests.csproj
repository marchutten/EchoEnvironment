<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net10.0-windows + UseWPF is still required here, but only because this project also tests
      WpfMath, the adapter, and MainWindow's angle readout. The Core tests themselves need nothing
      WPF; that separation is what ArchitectureInvariantTests enforces on Core.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Direct reference to Core: the domain tests exercise Core, not the App.
      Direct reference to Hardware: LineFramer and the three ISensorStream implementations (Phase 3).
      These tests need nothing WPF; they live here rather than in a separate Hardware.Tests project
      because the plan keeps one test project (§1 target graph: Tests -> Core, Hardware, Rendering).
      Reference to the App: MainWindow's angle expressions and the render-rate guards.
      Reference to Rendering (Phase 5): WpfMath moved here from the App, and the mesh/scene factories
      live here, so the boundary guards and the geometry tests now inspect this assembly.
    -->
    <ProjectReference Include="..\EchoEnvironment.Core\EchoEnvironment.Core.csproj" />
    <ProjectReference Include="..\EchoEnvironment.Hardware\EchoEnvironment.Hardware.csproj" />
    <ProjectReference Include="..\EchoEnvironment.Rendering\EchoEnvironment.Rendering.csproj" />
    <ProjectReference Include="..\EchoEnvironment\EchoEnvironment.csproj" />
  </ItemGroup>

</Project>
